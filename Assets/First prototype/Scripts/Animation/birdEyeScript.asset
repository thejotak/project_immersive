1cd7cc822","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-5677.0,"yMin":-433.0,"xMax":-5565.0,"yMax":-333.0},"title":"","body":"exit previous state","colorTheme":"Classic","guid":"7751995d-56b8-40a6-b91e-162650a3ec59","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-5028.0,"yMin":106.0,"xMax":-4916.0,"yMax":206.0},"title":"","body":"enter new state","colorTheme":"Classic","guid":"ed044115-f9d3-4d54-b8bf-34ecee29c71a","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-3010.0,"yMin":382.0,"xMax":-2910.0,"yMax":482.0},"title":"","body":"zou evt ook terug kunnen gaan naar shushing ipv listening","colorTheme":"Classic","guid":"3bf2ccf9-915f-42d5-9a61-058602001834","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-4011.0,"yMin":237.0,"xMax":-3911.0,"yMax":337.0},"title":"","body":"dit is listening!!","colorTheme":"Classic","guid":"d51306cd-8107-4bda-9e42-4422fde1ec7f","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-4743.0,"yMin":1333.0,"xMax":-4578.0,"yMax":1433.0},"title":"","body":"als je wilt dat het vanuit blinking ook kan, verbind deze!!!","colorTheme":"Classic","guid":"066b6a4a-0321-4cd8-b11a-935f8735292a","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}}'
